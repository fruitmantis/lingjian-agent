# Backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=
# Only used when initializing a completely empty database. Use a strong, unique password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE_BYTES=20971520
TASK_STALE_SECONDS=900
USER_APPLICATION_RATE_LIMIT=5
USER_APPLICATION_RATE_WINDOW_SECONDS=600
USER_APPLICATION_PENDING_LIMIT=200

# Optional path overrides for isolated validation/test environments.
# Production defaults remain data/app.db, data/uploads, and data/chroma.
# LINGJIAN_DATABASE_PATH=
# LINGJIAN_UPLOADS_DIR=
# LINGJIAN_CHROMA_DIR=

# External AI services
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
EMBEDDING_API_KEY=
