# Backend
# Required. PostgreSQL 16; set privately, never commit a real password.
# Example: postgresql+psycopg://banfei_app:<password>@127.0.0.1:5432/banfei_agent
DATABASE_URL=
# Comma-separated HTTP port-80 browser origins; put the actual server IP first.
BANFEI_IDENTITY_ORIGIN=http://<actual-server-ip>,http://localhost
CORS_ORIGINS=http://<actual-server-ip>,http://localhost
JWT_SECRET_KEY=
# Only used when initializing a completely empty database. Use a strong, unique password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE_BYTES=20971520
# Combined source text budget for AI partner profile generation; no silent truncation.
BANFEI_PROFILE_INPUT_MAX_CHARS=100000
USER_APPLICATION_RATE_LIMIT=5
USER_APPLICATION_RATE_WINDOW_SECONDS=600
USER_APPLICATION_PENDING_LIMIT=200

# PostgreSQL-only. Missing or unsupported DATABASE_URL fails explicitly.
# Dedicated local test database; never point this at banfei_agent.
BANFEI_TEST_DATABASE_URL=
# Local upload paths.
# LINGJIAN_UPLOADS_DIR=
# LINGJIAN_CHROMA_DIR=

# External AI services
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Model timeout/retries are managed only in Admin > Models; no environment override.
EMBEDDING_API_KEY=

# Same-origin public HTTP entry; the backend target stays on loopback.
NEXT_PUBLIC_API_BASE_URL=/api
BANFEI_API_PROXY_TARGET=http://127.0.0.1:8000
# BANFEI_BUILD_CPUS=1
