# Backend
# Required. PostgreSQL 16; set privately, never commit a real password.
# Example: postgresql+psycopg://banfei_app:<password>@127.0.0.1:5432/banfei_agent
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=
# Only used when initializing a completely empty database. Use a strong, unique password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE_BYTES=20971520
TASK_STALE_SECONDS=900
USER_APPLICATION_RATE_LIMIT=5
USER_APPLICATION_RATE_WINDOW_SECONDS=600
USER_APPLICATION_PENDING_LIMIT=200

# Local upload paths. SQLite path is retained only for explicit legacy validation/rollback.
# PostgreSQL runtime never opens SQLite; no automatic fallback if DATABASE_URL is missing.
# Explicit legacy mode requires DATABASE_URL=sqlite:// plus LINGJIAN_DATABASE_PATH.
# LINGJIAN_DATABASE_PATH=
# LINGJIAN_UPLOADS_DIR=
# LINGJIAN_CHROMA_DIR=

# External AI services
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
EMBEDDING_API_KEY=

# Optional frontend-only settings (frontend/.env.production).
# Leave unset for the existing local direct-backend setup.
# NEXT_PUBLIC_API_BASE_URL=/api
# BANFEI_API_PROXY_TARGET=http://127.0.0.1:8000
# BANFEI_BUILD_CPUS=1
