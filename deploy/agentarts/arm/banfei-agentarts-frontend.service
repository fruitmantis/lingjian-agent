[Unit]
ConditionPathExists=/etc/banfei-agentarts/data-copy-ready
Description=Banfei AgentArts isolated Next.js frontend
After=network-online.target banfei-agentarts-backend.service

[Service]
Type=simple
User=banfei-agentarts
Group=banfei-agentarts
WorkingDirectory=/opt/banfei-agentarts/current/frontend
EnvironmentFile=/etc/banfei-agentarts/frontend.env
ExecStart=/usr/local/bin/node /opt/banfei-agentarts/current/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/banfei -/var/lib/postgresql -/etc/postgresql -/var/backups
ReadWritePaths=/var/lib/banfei-agentarts /var/log/banfei-agentarts /var/cache/banfei-agentarts

[Install]
WantedBy=multi-user.target
