# Template only. Do not install with placeholders. Never copy original secrets.
BANFEI_DEPLOYMENT_PROFILE=agentarts
BANFEI_RUNTIME_MANAGER=systemd
BANFEI_IDENTITY_ORIGIN=http://banfei-agentarts.test
CORS_ORIGINS=http://banfei-agentarts.test
NEXT_PUBLIC_API_BASE_URL=/api
BANFEI_API_PROXY_TARGET=http://127.0.0.1:8001
FORWARDED_ALLOW_IPS=127.0.0.1
DATABASE_URL=postgresql+psycopg://banfei_agentarts_app:__NEW_PRIVATE_DB_PASSWORD__@127.0.0.1:55432/banfei_agentarts
JWT_SECRET_KEY=__NEW_PRIVATE_SIGNING_KEY__
BANFEI_IDENTITY_ENCRYPTION_KEY=__NEW_PRIVATE_FERNET_KEY__
BOOTSTRAP_ADMIN_USERNAME=__NEW_ADMIN_NAME__
BOOTSTRAP_ADMIN_PASSWORD=__NEW_PRIVATE_ADMIN_PASSWORD__
LINGJIAN_UPLOADS_DIR=/var/lib/banfei-agentarts/uploads
LINGJIAN_CHROMA_DIR=/var/lib/banfei-agentarts/unused-chroma
BANFEI_ERROR_LOG_PATH=/var/log/banfei-agentarts/errors.jsonl
TMPDIR=/var/lib/banfei-agentarts/tmp
HOME=/var/lib/banfei-agentarts
BANFEI_MATCH_EXECUTOR=runtime
BANFEI_DEVELOPMENT_EXECUTOR=runtime
BANFEI_RUNTIME_URL=https://defaultgw-gzswgzdcgz.cn-southwest-2.huaweicloud-agentarts.com/runtimes/banfei-runtime-test/invocations?endpoint=Latest
BANFEI_AGENTARTS_BEARER=__USER_PRIVATE_PLATFORM_API_KEY__
BANFEI_RUNTIME_SHARED_KEY=__USER_PRIVATE_ROTATED_SHARED_KEY__
BANFEI_RUNTIME_EXTERNAL_DATA_APPROVED=1
# New VM model record ONLY: https://api.deepseek.com + deepseek-flash.
# No model API key is copied here; the Runtime owns its model credential.
