[Unit]
Description=Banfei AgentArts independent HTTP port-80 entrypoint
After=network-online.target banfei-agentarts-frontend.service

[Service]
Type=simple
User=banfei-agentarts-caddy
Group=banfei-agentarts-caddy
WorkingDirectory=/var/lib/banfei-agentarts-caddy
Environment=HOME=/var/lib/banfei-agentarts-caddy
Environment=XDG_DATA_HOME=/var/lib/banfei-agentarts-caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/banfei-agentarts-caddy/config
Environment=XDG_CACHE_HOME=/var/cache/banfei-agentarts-caddy
StateDirectory=banfei-agentarts-caddy
StateDirectoryMode=0750
CacheDirectory=banfei-agentarts-caddy
CacheDirectoryMode=0750
LogsDirectory=banfei-agentarts-caddy
LogsDirectoryMode=0750
ExecCondition=/usr/local/libexec/banfei-environment-preflight agentarts http
ExecStart=/usr/local/lib/banfei-agentarts-caddy/caddy run --config /etc/banfei-agentarts-caddy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
StandardOutput=append:/var/log/banfei-agentarts-caddy/runtime.log
StandardError=append:/var/log/banfei-agentarts-caddy/runtime.log
SyslogIdentifier=banfei-agentarts-caddy

[Install]
WantedBy=multi-user.target
